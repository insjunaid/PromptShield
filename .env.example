# Copy to .env and fill in. .env is git-ignored. Never commit a real token.

# Free Hugging Face read token, for the gated Prompt Guard 2 models.
# Without one, export the ungated ProtectAI fallback instead (export_classifiers.py --model fallback).
HF_TOKEN=

# Local Ollama server.
OLLAMA_URL=http://localhost:11434

# Local models: the agent and the judge are the same model, the one every benchmark used.
PROMPTSHIELD_AGENT_MODEL=qwen3:4b-instruct
PROMPTSHIELD_JUDGE_MODEL=qwen3:4b-instruct

# Optional overrides. Defaults live in promptshield/config.py.
# PROMPTSHIELD_NUM_CTX=8192
# PROMPTSHIELD_LOG_FORMAT=dev
