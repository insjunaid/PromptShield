# Anchored so the lab's generated .env files aren't caught by accident.
/.env

# Generated per lab run: sandbox, outbox, canaries.
/lab/runs/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Python
/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
htmlcov/

# Frontend
node_modules/
dist/

# Runtime data (SQLite and similar).
/data/

# Generated by lab/attack_site/build.py.
/lab/attack_site/public/

# Exported classifiers: large, rebuilt by scripts/export_classifiers.py
models/

# Playwright browsers, installed inside the project (Checkpoint 6, answer A)
.playwright/
dashboard/test-results/
dashboard/playwright-report/

# Private working notes and agent instructions: kept on disk, never published.
/CLAUDE.md
/START_HERE.md
/.claude/
/docs/*.md

# Built dashboard for the package (scripts/build_dashboard.py), and the CLI's server list.
/promptshield/web/
/servers.json
/dist/
