{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|WebFetch|WebSearch|Read|Write|Edit|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8000/v1/hooks/claude",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch|Read|Grep|Bash|PowerShell",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8000/v1/hooks/claude",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
