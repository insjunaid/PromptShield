    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "framer-motion": "^14.13.0",
    "lucide-react": "^1.72.0",
